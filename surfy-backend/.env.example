# OpenAI API 키 (필수)
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-...

# Supervisor에서 사용할 GPT 모델 (기본값: gpt-4o-mini)
SUPERVISOR_MODEL=gpt-4o-mini
RESTAURANT_CURATION_MODEL=gpt-4o-mini
EVENT_AGENT_MODEL=gpt-4o-mini

# Restaurant Agent enriched DB / Chroma 설정
# 기존 FOODIE_* 이름도 legacy fallback으로 계속 동작
# 기본값은 surfy-backend/data 아래를 사용
ENRICHED_DB_PATH=./data/foodie_enriched.db
RESTAURANT_ENRICHED_DB_PATH=./data/foodie_enriched.db
FOODIE_CHROMA_PATH=./data/chroma_db
RESTAURANT_CHROMA_PATH=./data/chroma_db
FOODIE_CHROMA_COLLECTION=foodie_places
RESTAURANT_CHROMA_COLLECTION=foodie_places
FOODIE_EMBED_PROVIDER=local_hash
RESTAURANT_EMBED_PROVIDER=local_hash
FOODIE_EMBED_MODEL=text-embedding-3-small
RESTAURANT_EMBED_MODEL=text-embedding-3-small

# Event Agent DB
EVENT_DB_PATH=./data/event_db.sqlite3
EVENT_DB_TABLE=events_event
