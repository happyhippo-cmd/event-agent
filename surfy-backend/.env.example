# OpenAI API 키 (필수)
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-...

# Supervisor에서 사용할 GPT 모델 (기본값: gpt-4o-mini)
SUPERVISOR_MODEL=gpt-4o-mini

# Foodie Agent enriched DB / Chroma 설정
# 기본값은 surfy-backend/data 아래를 사용
ENRICHED_DB_PATH=./data/foodie_enriched.dh
FOODIE_CHROMA_PATH=./data/chroma_db
FOODIE_CHROMA_COLLECTION=foodie_places
FOODIE_EMBED_MODEL=text-embedding-3-small
