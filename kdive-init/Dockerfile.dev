# syntax=docker/dockerfile:1.6
# ---------------------------------------------------------------------------
# kdive-init (Next.js) - Development image
#   - hot reload (next dev) 지원
#   - 소스는 docker-compose volume 으로 마운트해서 사용
# ---------------------------------------------------------------------------
FROM node:22-alpine

# Next.js dev 가 사용하는 watcher 가 musl 환경에서 동작하도록
ENV NODE_ENV=development \
    NEXT_TELEMETRY_DISABLED=1 \
    CHOKIDAR_USEPOLLING=true \
    WATCHPACK_POLLING=true

WORKDIR /app

# 베이스 보안 패치
RUN apk upgrade --no-cache

# 의존성 레이어 캐싱을 위해 lockfile 먼저 복사
COPY package.json package-lock.json* ./

RUN npm ci --no-audit --no-fund

# 나머지 소스 (compose 에서 다시 마운트되지만 빈 이미지 단독 실행 대비)
COPY . .

EXPOSE 3000

# host 0.0.0.0 로 바인딩해야 컨테이너 밖에서 접근 가능
CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0", "-p", "3000"]
